    "smoke-test": "node smoke-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "3.1152.0",
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-lambda": "3.1152.0",
    "@aws-sdk/client-wafv2": "3.1152.0",
    "@aws-sdk/credential-providers": "3.1152.0"
  }
}
